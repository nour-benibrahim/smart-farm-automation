# ============================================================
# Smart Farm — root .gitignore
# ============================================================

# --- Secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
# copy secrets.h.example -> secrets.h locally
firmware/secrets.h
secrets.h

# --- Database dumps with personal data / credentials ---
backend/sfdb_postgres.sql

# --- Internship / personal documents ---
docs/FEED_IN_GREEN_Smart_Farm_Internship.pdf

# --- Build outputs & dependencies ---
node_modules/
dist/
build/
*.tsbuildinfo
.venv/
venv/
__pycache__/
*.py[cod]

# --- Internal presentations & archives ---
presentation/
backend/smart-farm-backend/presentation/
*.zip
*.tar.gz
*.tgz

# --- OS / editor artefacts ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/settings.json
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*

