# ============================================================
# Smart Farm backend — .gitignore
# ============================================================

# --- Secrets & credentials (NEVER commit) ---
.env
.env.local
.env.production
.env.test

# --- Build output ---
dist/
build/
*.tsbuildinfo

# --- Node.js dependencies ---
node_modules/

# --- Python virtual environment ---
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*

# --- Archives ---
*.zip
*.tar.gz
*.tgz

# --- Internal / presentation assets (not for public repo) ---
presentation/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json

# --- TypeScript incremental build cache ---
tsconfig.build.tsbuildinfo

