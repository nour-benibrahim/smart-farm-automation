# Local development environment
NODE_ENV=development
PORT=3000

# Database connection used by src/config/typeorm.config.ts
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@localhost:5432/sfdb

# Optional fallback values used by scripts and non-PostgreSQL helpers
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=<YOUR_PASSWORD>
DB_NAME=sfdb
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_SSL=false

# App security and browser access
JWT_SECRET=<SET_A_LONG_RANDOM_SECRET>
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://127.0.0.1:4200,http://localhost:4200
LOG_LEVEL=error

# MQTT broker settings
MQTT_BROKER=<SET_MQTT_BROKER_URL>
MQTT_USERNAME=<SET_MQTT_USERNAME>
MQTT_PASSWORD=<SET_MQTT_PASSWORD>
