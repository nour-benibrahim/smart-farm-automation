/*
  secrets.h.example — Copy this file to secrets.h and fill in your values.

  IMPORTANT: secrets.h is listed in .gitignore and must NEVER be committed.
             Only this example file belongs in version control.
*/
#ifndef SECRETS_H
#define SECRETS_H

// ---- Wi-Fi credentials ----
#define WIFI_SSID     "<YOUR_WIFI_SSID>"
#define WIFI_PASSWORD "<YOUR_WIFI_PASSWORD>"

// ---- EMQX Cloud MQTT credentials ----
// Broker: wss://<YOUR_EMQX_HOST>:<PORT>/mqtt
#define MQTT_BROKER_HOST "<YOUR_EMQX_HOST>"
#define MQTT_BROKER_PORT 8084
#define MQTT_WS_PATH     "/mqtt"
#define MQTT_USER        "<YOUR_MQTT_USERNAME>"
#define MQTT_PASS        "<YOUR_MQTT_PASSWORD>"

// ---- EMQX CA certificate (TLS verification) ----
// Paste the PEM content from the EMQX Cloud console.
// Required when USE_CA_CERT is set to 1 in the .ino file.
#define EMQX_CA_CERT_PEM \
"-----BEGIN CERTIFICATE-----\n" \
"<paste your CA certificate lines here>\n" \
"-----END CERTIFICATE-----\n"

#endif // SECRETS_H
